# VintageNet installs per-interface routes in multiple policy-routing tables.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# The Nerves application-data partition is formatted and mounted as ext4.
CONFIG_EXT4_FS=y

# Mount the FAT boot partition from Linux when servicing boot.scr.
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# The real RK3308 codec should be ALSA card 0 and the default PCM. The vendor
# defconfig enables the synthetic loopback card, which otherwise claims card 0.
# CONFIG_SND_ALOOP is not set

# USB host support. The vendor defconfig has CONFIG_USB unset entirely, even
# though the devicetree already enables a dedicated host controller
# (usb_host0_ehci/usb_host0_ohci, both "generic-ehci"/"generic-ohci" -
# separate from the usb20_otg port) - so nothing plugged into the host port
# was ever recognized, regardless of what device it was. EHCI/OHCI cover the
# dedicated host port; SND_USB_AUDIO adds USB audio class device support.
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_SND_USB_AUDIO=y
