# Custom U-Boot base environment for Nerves on the ROCK Pi S (RK3308).
#
# DRAFT, adapted from nerves_system_radxa_cm3's uboot/boot.env (a working
# Nerves system for a different Rockchip SoC, RK3566) -- structure/logic
# not yet build/boot tested, though the memory addresses below are now
# RK3308's real values (see comment further down). That system boots the
# kernel/dtb/vars.txt straight off the rootfs partition via `load mmc`
# rather than a separate FAT boot partition, which this follows too.
#
# This file is baked into a raw uboot-env.bin at build time (see
# nerves_defconfig's BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE_SOURCE) and
# written to the U-Boot environment offset by fwup at provisioning time.
# fwup.conf.eex patches individual a./b. metadata variables on top of
# this baseline at provision/upgrade time -- it does not replace this
# script logic.

#
# Nerves variables
#

nerves_fw_active=a

# nerves_fw_autovalidate controls whether updates are considered valid once
# applied. If set to 0, the user needs to set nerves_fw_validated to 1 in
# their application. If they don't set it before a reboot, then the
# previous software is run. If 1, then no further action needs to be taken.
nerves_fw_autovalidate=1

# nerves_fw_validated is 1 if the current boot selection is accepted. It is
# set to 1 here, since this environment is written in the factory, so it is
# implicitly valid.
nerves_fw_validated=1

# nerves_fw_booted is 0 for the first boot and 1 for all reboots after that.
nerves_fw_booted=0

nerves_revert=\
    if test ${nerves_fw_active} = "a"; then\
        echo "Reverting to partition B";\
        setenv nerves_fw_active "b";\
    else\
        echo "Reverting to partition A";\
        setenv nerves_fw_active "a";\
    fi

nerves_init=\
    if test ${nerves_fw_booted} = 1; then\
        if test ${nerves_fw_validated} = 0; then\
            run nerves_revert;\
            setenv nerves_fw_validated 1;\
            saveenv;\
        fi;\
    else\
        setenv nerves_fw_booted 1;\
        if test ${nerves_fw_autovalidate} = 1; then\
            setenv nerves_fw_validated 1;\
        fi;\
        saveenv;\
    fi;\
    setenv bootfile Image;\
    if test ${nerves_fw_active} = "a"; then\
        echo "Booting Partition A";\
        setenv uenv_root /dev/mmcblk2p2;\
        setenv bootpart 0:2;\
    else\
        echo "Booting Partition B";\
        setenv uenv_root /dev/mmcblk2p3;\
        setenv bootpart 0:3;\
    fi

# Load boot vars, kernel, dtb and any overlays straight off the rootfs
# partition (squashfs) instead of a separate FAT boot partition.
uname_boot=\
    echo "loading kernel and device tree from FAT boot partition";\
    setenv bootpart 0:1;\
    setenv bootfile Image;\
    setenv fdtfile rk3308-rock-s0.dtb;\
    setenv bootargs root=${uenv_root} rootfstype=squashfs earlyprintk console=ttyS0,115200n8 rw rootwait ${extra_bootargs};\
    fatload mmc ${bootpart} ${fdt_addr_r} ${fdtfile};\
    fatload mmc ${bootpart} ${kernel_addr_r} ${bootfile};\
    fdt addr ${fdt_addr_r};\
    echo booting linux ...;\
    echo debug: [${bootargs}] ...;\
    booti ${kernel_addr_r} - ${fdt_addr_r}

# Board memory-layout defaults. Once CONFIG_ENV_IS_IN_MMC is active,
# U-Boot loads *this* saved environment instead of falling back to its
# board's compiled-in CONFIG_EXTRA_ENV_SETTINGS defaults, so these have
# to be copied in explicitly or load/booti have nowhere to put things.
# Pulled from the CONFIG_ARM64 branch of ENV_MEM_LAYOUT_SETTINGS in
# include/configs/rk3308_common.h in the actual radxa/u-boot build output
# (buildroot/output/build/uboot-233a23e3.../include/configs/rk3308_common.h)
# -- these are RK3308's real values, not copied from another chip.
scriptaddr=0x00500000
pxefile_addr_r=0x00600000
fdt_addr_r=0x01f00000
kernel_addr_r=0x00680000
ramdisk_addr_r=0x04000000

bootdelay=-2

# Boot
bootcmd=run nerves_init uname_boot
